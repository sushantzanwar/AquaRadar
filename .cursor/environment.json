{
  "name": "AquaWatch",
  "install": "bash .cursor/scripts/cloud-agent-install.sh",
  "terminals": [
    {
      "name": "api",
      "command": "source .venv/bin/activate && uvicorn aquawatch.main:app --host 127.0.0.1 --port 8000 --reload"
    },
    {
      "name": "frontend",
      "command": "cd frontend && npm run dev -- --host 127.0.0.1"
    }
  ],
  "ports": [
    8000,
    5173
  ]
}
